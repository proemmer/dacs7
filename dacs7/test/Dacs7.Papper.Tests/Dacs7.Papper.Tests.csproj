<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net461</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!--<DefineConstants>REALPLC;$(AdditionalConstants)</DefineConstants>-->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(Dacs7KeyFile)</AssemblyOriginatorKeyFile>
    <PublicSign>$(Dacs7PublicSign)</PublicSign>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.2.0" />
    <PackageReference Include="xunit" Version="2.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.0" />
    <PackageReference Include="coverlet.collector" Version="1.2.0" />
    <PackageReference Include="Papper" Version="2.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dacs7\Dacs7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- run the tests in the default app domain, because .NET Framework does not load public signed assemblies into a new app domain -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
