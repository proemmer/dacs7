<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>    
    <TargetFrameworks>net6.0;net461</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!--<DefineConstants>REALPLC;$(AdditionalConstants)</DefineConstants>-->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(Dacs7KeyFile)</AssemblyOriginatorKeyFile>
    <PublicSign>$(Dacs7PublicSign)</PublicSign>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="2.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="15.9.0" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dacs7\Dacs7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{82a7f48d-3b50-4b1e-b82e-3ada8210c358}" />
  </ItemGroup>


  <ItemGroup>
    <!-- run the tests in the default app domain, because .NET Framework does not load public signed assemblies into a new app domain -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
